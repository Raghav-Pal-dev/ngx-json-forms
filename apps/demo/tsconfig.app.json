{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "rootDir": "../../",
    "types": ["node"],
    "lib": ["es2022", "dom", "dom.iterable"]
  },
  "include": [
    "src/**/*.ts",
    "../../packages/core/src/**/*.ts",
    "../../packages/primeng/src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "../../packages/core/src/**/*.spec.ts",
    "../../packages/primeng/src/**/*.spec.ts"
  ]
}
