{
  "name": "@org/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build:core": "nx build core",
    "build:primeng": "nx build primeng",
    "build:all": "nx build core && nx build primeng",
    "publish:core": "nx build core && cd dist/packages/core && npm publish --access public",
    "publish:primeng": "nx build primeng && cd dist/packages/primeng && npm publish --access public",
    "publish:all": "npm run publish:core && npm run publish:primeng",
    "serve:demo": "nx serve demo",
    "test": "nx run-many --target=test --all"
  },
  "private": true,
  "devDependencies": {
    "@angular-devkit/core": "~21.2.0",
    "@angular-devkit/schematics": "~21.2.0",
    "@angular/build": "~21.2.0",
    "@angular/cli": "~21.2.0",
    "@angular/compiler-cli": "~21.2.0",
    "@angular/language-service": "~21.2.0",
    "@eslint/js": "^9.8.0",
    "@nx/angular": "^22.6.5",
    "@nx/devkit": "22.6.5",
    "@nx/eslint": "22.6.5",
    "@nx/eslint-plugin": "22.6.5",
    "@nx/js": "22.6.5",
    "@nx/playwright": "22.6.5",
    "@nx/web": "22.6.5",
    "@oxc-project/runtime": "^0.115.0",
    "@playwright/test": "^1.36.0",
    "@schematics/angular": "~21.2.0",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@typescript-eslint/utils": "^8.40.0",
    "angular-eslint": "^21.2.0",
    "autoprefixer": "^10.4.0",
    "cropperjs": "^1.6.2",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-playwright": "^1.6.2",
    "jsdom": "^27.1.0",
    "jsonc-eslint-parser": "^2.1.0",
    "marked": "^16.4.2",
    "ng-packagr": "~21.2.0",
    "nx": "22.6.5",
    "postcss": "^8.4.5",
    "prettier": "^3.8.1",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "verdaccio": "^6.3.2",
    "vitest": "^4.0.8"
  },
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@angular/animations": "^21.2.10",
    "@angular/cdk": "^21.2.8",
    "@angular/common": "~21.2.0",
    "@angular/compiler": "~21.2.0",
    "@angular/core": "~21.2.0",
    "@angular/forms": "~21.2.0",
    "@angular/platform-browser": "~21.2.0",
    "@angular/router": "~21.2.0",
    "@primeng/themes": "^21.0.4",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.6",
    "quill": "^2.0.3",
    "rxjs": "~7.8.0"
  },
  "nx": {
    "includedScripts": [],
    "targets": {
      "local-registry": {
        "executor": "@nx/js:verdaccio",
        "options": {
          "port": 4873,
          "config": ".verdaccio/config.yml",
          "storage": "tmp/local-registry/storage"
        }
      }
    }
  }
}
